<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:arrowButtonRight="assets.graphics.arrowButtonRight.*"
		xmlns:components="components.*"
		viewActivate="viewActiveHandler(event)">

	<s:navigationContent>
		<s:Image source="@Embed('assets/images/SNIP.png')"/>
	</s:navigationContent>

	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;

			import spark.events.TextOperationEvent;

			private const CORRECT_API_KEY_FOR_TESTING:String="YOUR_API_KEY";
			private var enteredApiKey:String;

			private function viewActiveHandler(event:Event):void
			{
				addEventListener(Event.ADDED_TO_STAGE, onAddedToStage);
			}

			private function onAddedToStage(event:Event):void
			{
				stage.addEventListener(StageOrientationEvent.ORIENTATION_CHANGE, onOrientationChange);
			}

			private function onOrientationChange(event:StageOrientationEvent):void
			{
				trace(event.afterOrientation);
			}

			private function onClick():void
			{
				var dataObj:Object=new Object();
				dataObj.key=enteredApiKey;
				navigator.pushView(AuthResultView, dataObj);
			}

			protected function textInput_changeHandler(event:TextOperationEvent):void
			{
				enteredApiKey=event.target.text;
			}
		]]>
	</fx:Script>

	<s:SkinnableContainer skinClass="skins.BlackBoxSkin"
						  top="0"
						  left="0"
						  width="100%"
						  height="40">
		<s:Label text="New Key"
				 color="0xffffff"
				 left="10"
				 top="10"
				 fontSize="24"/>
	</s:SkinnableContainer>

	<s:VGroup verticalCenter="0"
			  horizontalCenter="0"
			  horizontalAlign="right">
		<s:TextArea id="explanation"
					editable="false"
					fontSize="24"
					borderVisible="false"
					contentBackgroundAlpha="0"
					text="Enter your Snipplr api key. Your api key can be found on snipplr.com on your settings page."/>
		<s:TextInput id="textInput"
					 change="textInput_changeHandler(event)"/>
		<components:rightArrowButton click="onClick()"/>

	</s:VGroup>
</s:View>
