<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		viewActivate="onViewActivate()">

	<s:navigationContent>
		<s:Image source="@Embed('assets/images/SNIP.png')"/>
	</s:navigationContent>

	<s:actionContent>
		<s:Button icon="@Embed('assets/images/menuLightGrey.png')"
				  click="popup.show()"/>
	</s:actionContent>

	<fx:Script>
		<![CDATA[
			import components.MenuPopUp;

			private var popup:MenuPopUp;

			private function onViewActivate():void
			{
				popup=new MenuPopUp();
			}
		]]>
	</fx:Script>

	<s:SkinnableContainer skinClass="skins.BlackBoxSkin"
						  top="0"
						  left="0"
						  width="100%"
						  height="40">
		<s:HGroup left="10"
				  top="10">
			<s:Label id="titleLabel"
					 text="About SNIP"
					 color="0xffffff"
					 left="10"
					 top="10"
					 fontSize="24"/>
		</s:HGroup>
	</s:SkinnableContainer>

	<s:VGroup verticalCenter="0"
			  horizontalCenter="0"
			  horizontalAlign="center"
			  verticalAlign="middle">
		<s:Image source="@Embed('assets/images/icons/SNIP128.png')"/>
		<s:Label text="SNIP is a SquidZoo app."/>
		<s:Label text="Version 1.03"/>
		<s:Label text="SNIP Copyright Gunnar Karlsson 2011."/>
		<s:Label text="All rights reserved."/>
		<s:Label text="All trademarks, including Snipplr.com, are"/>
		<s:Label text="the property of their respective owners."/>
	</s:VGroup>

</s:View>
