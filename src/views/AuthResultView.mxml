<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:components="components.*"
		viewActivate="viewActivateHandler(event)">

	<s:navigationContent>
		<s:Image source="@Embed('assets/images/SNIP.png')"/>
	</s:navigationContent>

	<s:states>
		<s:State name="processing"/>
		<s:State name="incorrectKey"/>
		<s:State name="correctKey"/>
	</s:states>

	<fx:Script>
		<![CDATA[
			import Utils.KeyManager;

			import com.mattism.http.xmlrpc.ConnectionImpl;
			import com.mattism.http.xmlrpc.MethodFault;
			import com.mattism.http.xmlrpc.util.*;

			import mx.events.FlexEvent;

			import spark.events.TextOperationEvent;
			import spark.events.ViewNavigatorEvent;

			private const CORRECT_API_KEY_FOR_TESTING:String="YOUR_API_KEY";
			private var _rpc:ConnectionImpl;
			private var _key:String;

			protected function viewActivateHandler(event:ViewNavigatorEvent):void
			{
				currentState="processing"

				_key=data.key;
				_rpc=new ConnectionImpl('http://snipplr.com/xml-rpc.php');
				_rpc.addEventListener(Event.COMPLETE, rpcCompleteHandler);
				_rpc.addEventListener(ErrorEvent.ERROR, rpcErrorHandler);
				_rpc.addParam(_key, XMLRPCDataTypes.STRING);
				_rpc.call('user.checkkey');
			}

			private function rpcCompleteHandler(evt:Event):void
			{
				bi.visible=false;

				var response:Object=_rpc.getResponse();

				if (int(response) == 1)
				{
					trace("api key is valid");
					currentState="correctKey";

					KeyManager.setKey(_key);

				}
				else
				{
					trace("api key is invalid");
					currentState="incorrectKey";
				}
			}

			private function rpcErrorHandler(evt:ErrorEvent):void
			{
				var fault:MethodFault=_rpc.getFault();
			}

			private function onClick():void
			{

			}
		]]>
	</fx:Script>

	<s:SkinnableContainer skinClass="skins.BlackBoxSkin"
						  top="0"
						  left="0"
						  width="100%"
						  height="40">
		<s:Label text="Key Validation"
				 color="0xffffff"
				 left="10"
				 top="10"
				 fontSize="24"/>
	</s:SkinnableContainer>

	<!--~~~~~~~~~~~~~~~~~~processing state~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->

	<s:VGroup includeIn="processing"
			  horizontalCenter="0"
			  verticalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<s:BusyIndicator id="bi"
						 scaleX="3"
						 scaleY="3"/>
		<s:Label text="validating key..."/>
	</s:VGroup>

	<!--~~~~~~~~~~~~~~~~~~~incorrectKey state~~~~~~~~~~~~~~~~~~~~~~~~-->

	<s:VGroup gap="100"
			  includeIn="incorrectKey"
			  horizontalCenter="0"
			  verticalCenter="0"
			  horizontalAlign="left">
		<s:HGroup verticalAlign="middle">
			<s:Image includeIn="incorrectKey"
					 x="147"
					 y="83"
					 source="assets/images/Untitled-1.png"/>
			<s:Label text="The entered key is invalid"/>
		</s:HGroup>
		<s:HGroup verticalAlign="middle">
			<components:leftArrowButton2 includeIn="incorrectKey"
										 click="navigator.pushView(AuthView)"/>
			<s:Label includeIn="incorrectKey"
					 text="Try Again"/>
		</s:HGroup>
	</s:VGroup>

	<!--~~~~~~~~~~~~~~~~~~~``correctKey state~~~~~~~~~~~~~~~~~~~~~~~-->

	<s:VGroup includeIn="correctKey"
			  horizontalCenter="0"
			  verticalCenter="0"
			  horizontalAlign="right">
		<s:HGroup verticalAlign="middle">
			<s:Image includeIn="correctKey"
					 source="assets/images/Correct.png"/>
			<s:Label includeIn="correctKey"
					 text="Your key is valid and saved"/>
		</s:HGroup>
		<s:HGroup verticalAlign="middle">
			<s:Label includeIn="correctKey"
					 text="Go to your snippets"/>
			<components:rightArrowButton includeIn="correctKey"
										 click="navigator.pushView(SnippetListView)"/>
		</s:HGroup>
	</s:VGroup>

</s:View>
