<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:mx="library://ns.adobe.com/flex/halo"
		destructionPolicy="never"
		creationComplete="creationCompleteHandler(event)">
	<s:navigationContent>
		<s:Image source="@Embed('assets/images/SNIP.png')"/>
	</s:navigationContent>

	<s:actionContent>
		<s:Button icon="@Embed('assets/images/refresh-grey-999999.png')"
				  click="onClickRefresh()"/>
		<s:Button icon="@Embed('assets/images/menuLightGrey.png')"
				  click="popup.show()"/>
	</s:actionContent>

	<s:states>
		<s:State name="preloading"/>
		<s:State name="noSnippetsAvialable"/>
		<s:State name="snippetsRetrieved"/>
	</s:states>

	<fx:Script>
		<![CDATA[
			import Utils.KeyManager;

			import VOs.SnippetVO;

			import com.mattism.http.xmlrpc.ConnectionImpl;
			import com.mattism.http.xmlrpc.MethodFault;
			import com.mattism.http.xmlrpc.util.*;
			import com.squidzoo.eventSystem.EventCentral;
			import com.squidzoo.eventSystem.events.CustomDataEvent;

			import components.MenuPopUp;

			import mx.collections.ArrayCollection;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.utils.ArrayUtil;

			[Bindable]
			private var popup:MenuPopUp;

			private const API_KEY:String="d67faddca3e68970ccd4";
			private var _rpc:ConnectionImpl;
			[Bindable]
			private var _irLabel:String="snippet";

			[Bindable]
			private var snippetAC:ArrayCollection=new ArrayCollection(new Array());

			[Bindable]
			private var _stage:Stage;

			private function onClickRefresh():void
			{
				init();
			}

			private function creationCompleteHandler(event:FlexEvent=null):void
			{
				currentState="preloading";
				titleLabel.text="Your Snippets";
				init();
			}

			private function init():void
			{
				popup=new MenuPopUp();
				var key:String=KeyManager.getKey();

				_rpc=new ConnectionImpl('http://snipplr.com/xml-rpc.php');
				_rpc.addEventListener(Event.COMPLETE, rpcCompleteHandler);
				_rpc.addEventListener(ErrorEvent.ERROR, rpcErrorHandler);

				_rpc.addParam(key, XMLRPCDataTypes.STRING);
				_rpc.call('snippet.list');

			}

			private function rpcCompleteHandler(evt:Event):void
			{
				snippetAC.removeAll();

				var response:Object=_rpc.getResponse();
				var snippetArray:Array=ArrayUtil.toArray(response);

				for (var i:int=0; i < snippetArray.length; i++)
				{
					var obj:Object=snippetArray[i];
					var vo:SnippetVO=new SnippetVO();
					vo.id=obj.id;
					vo.title=obj.title;
					snippetAC.addItem(vo);
				}

				currentState="snippetsRetrieved";
			}

			private function rpcErrorHandler(evt:ErrorEvent):void
			{
				titleLabel.text="Error. Refresh to try again"
				var fault:MethodFault=_rpc.getFault();
			}

			private function onListClick(event:Event):void
			{
				navigator.pushView(SingleSnippetView, snippetList.selectedItem);
			}
		]]>
	</fx:Script>

	<s:VGroup width="100%"
			  height="100%"
			  gap="0">
		<s:SkinnableContainer id="header"
							  includeIn="noSnippetsAvialable,preloading,snippetsRetrieved"
							  skinClass="skins.BlackBoxSkin"
							  top="0"
							  left="0"
							  width="100%"
							  height="40">
			<s:Label id="titleLabel"
					 text="Your Snippets"
					 color="0xffffff"
					 left="10"
					 top="10"
					 fontSize="24"/>
		</s:SkinnableContainer>

		<s:List includeIn="snippetsRetrieved"
				id="snippetList"
				width="100%"
				height="100%"
				dataProvider="{snippetAC}"
				click="onListClick(event)">
			<s:itemRenderer>
				<fx:Component>
					<s:IconItemRenderer labelField=""
										messageField="title"
										decorator="@Embed('assets/images/arrowBlack.png')"/>
				</fx:Component>
			</s:itemRenderer>
		</s:List>

	</s:VGroup>


	<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ preloading state ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->

	<s:VGroup includeIn="preloading"
			  verticalCenter="0"
			  horizontalCenter="0"
			  verticalAlign="middle"
			  horizontalAlign="center">
		<s:BusyIndicator scaleX="3"
						 scaleY="3"/>
		<s:Label text="Requesting"/>
		<s:Label text="snippets"/>
	</s:VGroup>

	<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ snippetRetrieved state ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->


</s:View>
