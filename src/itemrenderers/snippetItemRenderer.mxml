<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
				xmlns:s="library://ns.adobe.com/flex/spark"
				height="100"
				width="100%">

	<fx:Script>
		<![CDATA[
			[Embed(source="assets/images/rightArrowBlue.png")]
			[Bindable]
			public var arrowImage:Class;
		]]>
	</fx:Script>

	<s:SkinnableContainer skinClass="skins.ItemRendererSkin"
						  width="100%"
						  height="100%">
		<s:Label text="{data.title}"
				 left="20"
				 top="20"
				 verticalAlign="middle"/>
		<s:Group right="0"
				 top="0">
			<s:Image source="{arrowImage}"/>
		</s:Group>
	</s:SkinnableContainer>


</s:ItemRenderer>
